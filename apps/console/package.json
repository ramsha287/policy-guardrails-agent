{
  "name": "guardrail-console",
  "private": true,
  "version": "0.5.0",
  "description": "Operator console for the guardrail control plane: human review queue, pipeline, catalog, fleet and analytics.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "node e2e/dev-mock.mjs",
    "build": "tsc -p . && vite build",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "e2e": "node e2e/smoke.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.55.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
