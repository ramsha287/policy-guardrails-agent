{
  "version": "staging-2026.09.23-1",
  "environment": "staging",
  "assignments": [
    {
      "id": "global-ai-gateway-pii",
      "guardrail_id": "ai-gateway-pii",
      "guardrail_version": "1.0.0",
      "scope_type": "global",
      "stages": ["input", "output"],
      "order": 10,
      "enabled": true,
      "mode": "enforce",
      "failure_mode": "fail_closed",
      "timeout_ms": 800,
      "config": {
        "project_id": "${AI_GATEWAY_PROJECT_ID}",
        "base_url": "${AI_GATEWAY_URL:-http://instant-redaction-service:8001}",
        "input": {"on_detect": "modify", "block_entities": ["US_SSN"], "scan_roles": ["user"]},
        "output": {"on_detect": "modify", "block_entities": ["CREDIT_CARD", "US_SSN"], "scan_roles": ["assistant"]}
      }
    },
    {
      "id": "global-noop",
      "guardrail_id": "noop",
      "guardrail_version": "1.0.0",
      "scope_type": "global",
      "stages": ["input", "retrieval", "tool", "output"],
      "order": 1000,
      "enabled": true,
      "mode": "shadow"
    }
  ]
}
